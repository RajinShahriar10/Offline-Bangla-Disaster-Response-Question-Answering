# Normalise text files in the repo to LF; keep them LF in the working tree too,
# so the Bangla CSV/TEX content does not churn across Windows/Linux clones.
* text=auto eol=lf

*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.tex  text eol=lf
*.bib  text eol=lf
*.cff  text eol=lf
*.csv  text eol=lf

# LaTeX build products are never tracked
*.pdf  binary
*.png  binary
